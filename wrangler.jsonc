{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "divdivedigital",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "divdivedigital.com", "custom_domain": true },
    { "pattern": "www.divdivedigital.com", "custom_domain": true }
  ]
}
