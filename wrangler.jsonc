{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "divdivedigital",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "LEADS", "id": "84cb07b062744cc5bf34787771b2a3f6" }
  ],
  // Lead alerts: forms email LEAD_TO via Resend. Add the secret RESEND_API_KEY
  // in Cloudflare (Workers > divdivedigital > Settings > Variables and Secrets).
  "vars": { "LEAD_FROM": "website@divdivedigital.com", "LEAD_TO": "info@divdivedigital.com" },
  // Optional Cloudflare fallback instead of Resend:
  // "send_email": [{ "name": "LEAD_EMAIL", "destination_address": "info@divdivedigital.com" }],
  "routes": [
    { "pattern": "divdivedigital.com", "custom_domain": true },
    { "pattern": "www.divdivedigital.com", "custom_domain": true }
  ]
}
